{
  "name": "@javierg1975/greybeard",
  "version": "1.0.0",
  "description": "Lazy senior dev mode for AI agents. The best code is the code you never wrote.",
  "keywords": ["opencode-plugin", "opencode", "greybeard", "pi-package", "pi", "skills", "qoder"],
  "license": "MIT",
  "author": {
    "name": "Dietrich Gebert",
    "url": "https://github.com/DietrichGebert"
  },
  "homepage": "https://github.com/javierg1975/greybeard",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/javierg1975/greybeard.git"
  },
  "bugs": {
    "url": "https://github.com/javierg1975/greybeard/issues"
  },
  "main": "./.opencode/plugins/greybeard.mjs",
  "exports": {
    ".": "./.opencode/plugins/greybeard.mjs",
    "./plugin": "./.opencode/plugins/greybeard.mjs"
  },
  "bin": {
    "greybeard": "hooks/check/index.js"
  },
  "files": [
    "AGENTS.md",
    "hooks/",
    "skills/",
    ".opencode/",
    ".qoder/",
    ".qoder-plugin/",
    "pi-extension/",
    "!pi-extension/test/",
    "scripts/uninstall.js",
    "scripts/cursor-hooks.js",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "test": "node --test tests/*.test.js && npm test --prefix pi-extension"
  },
  "pi": {
    "extensions": ["./pi-extension/index.js"],
    "skills": ["./skills"]
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "csv-parse": "^7.0.3",
    "eslint": "^10.14.0",
    "eslint-plugin-functional": "^10.0.1",
    "papaparse": "^5.7.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}

